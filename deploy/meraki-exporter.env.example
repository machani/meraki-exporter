# Environment file for meraki-exporter.
# Copy to /etc/meraki-exporter.env and restrict permissions:
#   sudo chmod 600 /etc/meraki-exporter.env
#   sudo chown root:root /etc/meraki-exporter.env

# REQUIRED: Meraki Dashboard API key.
# Generate at: Dashboard > Organization > Settings > Dashboard API access,
# then your profile > API access. Use a read-only admin account's key.
MERAKI_API_KEY=replace-me

# Organization ID. Optional if the key has access to exactly one org.
#MERAKI_ORG_ID=123456

# Listen address for /metrics (default :9822).
#LISTEN_ADDRESS=:9822

# Fast-group poll interval: devices, uplinks, wireless (default 120s, minimum 30s).
#SCRAPE_INTERVAL=120s

# Slow-group poll interval: clients, licenses, apiusage (default 15m, must be >= SCRAPE_INTERVAL).
#SLOW_SCRAPE_INTERVAL=15m

# Per-request API timeout (default 30s).
#MERAKI_TIMEOUT=30s

# Lookback window for client counts (default 1h).
#CLIENTS_TIMESPAN=1h

# Collectors to enable (default shown). vpn, switchports, sensors, and
# alerts are opt-in extras, not included by default. Note switchports fans
# out one API call per port, so enable it deliberately on switch-heavy orgs.
#COLLECTORS_ENABLED=devices,uplinks,clients,wireless,licenses,apiusage
#COLLECTORS_ENABLED=devices,uplinks,clients,wireless,licenses,apiusage,vpn,switchports,sensors,alerts

# Collectors polled at the slow interval (default shown).
#COLLECTORS_SLOW=clients,licenses,apiusage,alerts

# Log level: info or debug (default info).
#LOG_LEVEL=info

# Optional exporter-toolkit web config enabling TLS and/or basic auth.
# See web-config.example.yml. Empty/unset serves plain HTTP.
#WEB_CONFIG_FILE=/etc/meraki-exporter/web-config.yml

# Optional proxy for Meraki API requests (http://, https://, or socks5:// URL).
# Unset, the standard HTTP_PROXY/HTTPS_PROXY/NO_PROXY variables are honored
# if present. Only outbound API traffic is proxied, not the /metrics listener.
#MERAKI_PROXY_URL=http://proxy.example.com:3128
