{
  "title": "Meraki WAN / Uplinks",
  "uid": "meraki-uplink-wan",
  "description": "Appliance uplink status, packet loss, and latency from meraki-exporter",
  "tags": ["meraki", "network", "wan"],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "network",
        "type": "query",
        "label": "Network",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(meraki_uplink_status, network_name)", "refId": "A" },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uplinks Active",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "count(meraki_uplink_status{status=\"active\",network_name=~\"$network\"} == 1) or vector(0)", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uplinks Ready (standby)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "count(meraki_uplink_status{status=\"ready\",network_name=~\"$network\"} == 1) or vector(0)", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uplinks Down",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "count(meraki_uplink_status{status=~\"failed|not connected\",network_name=~\"$network\"} == 1) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg Packet Loss",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "avg(meraki_uplink_loss_percent{network_name=~\"$network\"})", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg Latency",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "avg(meraki_uplink_latency_seconds{network_name=~\"$network\"})", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.3 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Appliances Reporting",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "count(count by (serial) (meraki_uplink_status{network_name=~\"$network\"})) or vector(0)", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Packet Loss by Uplink",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "meraki_uplink_loss_percent{network_name=~\"$network\"}", "legendFormat": "{{network_name}} {{role}} {{interface}} ({{ip}}) / {{serial}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency by Uplink",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "meraki_uplink_latency_seconds{network_name=~\"$network\"}", "legendFormat": "{{network_name}} {{role}} {{interface}} ({{ip}}) / {{serial}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Uplink Traffic Sent",
      "description": "Throughput derived from the windowed byte count: meraki_uplink_sent_bytes / meraki_uplink_usage_window_seconds. The underlying metric is a sum over the poll window, NOT a counter — rate() or increase() on it would be meaningless. Reported per site and interface: the API returns usage per network, so an HA pair aggregates at the site level and cannot be split per appliance.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "meraki_uplink_sent_bytes{network_name=~\"$network\"} / on(job, instance) group_left() meraki_uplink_usage_window_seconds", "legendFormat": "{{network_name}} {{interface}}" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0, "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Uplink Traffic Received",
      "description": "Throughput derived from the windowed byte count: meraki_uplink_received_bytes / meraki_uplink_usage_window_seconds. Same caveats as the sent panel — windowed sum rather than a counter, and per site rather than per appliance.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "meraki_uplink_received_bytes{network_name=~\"$network\"} / on(job, instance) group_left() meraki_uplink_usage_window_seconds", "legendFormat": "{{network_name}} {{interface}}" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0, "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Top 10 Uplinks by Packet Loss",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "topk(10, meraki_uplink_loss_percent{network_name=~\"$network\"})", "instant": true, "legendFormat": "{{network_name}} {{role}} {{interface}} ({{ip}}) / {{serial}}" }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Top 10 Uplinks by Latency",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "topk(10, meraki_uplink_latency_seconds{network_name=~\"$network\"})", "instant": true, "legendFormat": "{{network_name}} {{role}} {{interface}} ({{ip}}) / {{serial}}" }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.3 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Current Uplink Status",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "meraki_uplink_status{network_name=~\"$network\"} == 1", "instant": true, "format": "table" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true, "namespace": true, "service": true, "endpoint": true, "network_id": true },
            "indexByName": { "serial": 0, "network_name": 1, "role": 2, "interface": 3, "status": 4 },
            "renameByName": { "serial": "Appliance", "network_name": "Network", "role": "Role", "interface": "Interface", "status": "Status" }
          }
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Warm Spare Failover",
      "description": "HA-enabled primaries with no active uplink — the spare has most likely taken over. 0 is healthy. A spare holding an active uplink is normal standby, not failover.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 29 },
      "targets": [
        { "refId": "A", "expr": "count(((meraki_appliance_ha_role{role=\"primary\",network_name=~\"$network\"} == 1) and on(serial) (meraki_appliance_ha_enabled == 1)) unless on(serial) (max by (serial) (meraki_uplink_status{status=\"active\"} == 1))) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "table",
      "title": "HA Appliances (warm spare)",
      "description": "Current warm-spare role per HA-enabled appliance.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 29 },
      "targets": [
        { "refId": "A", "expr": "(meraki_appliance_ha_role{network_name=~\"$network\"} == 1) and on(serial) (meraki_appliance_ha_enabled == 1)", "instant": true, "format": "table" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true, "namespace": true, "service": true, "endpoint": true, "network_id": true },
            "indexByName": { "serial": 0, "network_name": 1, "role": 2 },
            "renameByName": { "serial": "Appliance", "network_name": "Network", "role": "Role" }
          }
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
