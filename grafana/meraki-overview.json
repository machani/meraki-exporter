{
  "title": "Meraki Overview",
  "uid": "meraki-overview",
  "description": "Cisco Meraki Dashboard metrics from meraki-exporter",
  "tags": ["meraki", "network"],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Devices Online",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "count(meraki_device_status{status=\"online\"} == 1) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Devices Alerting",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "count(meraki_device_status{status=\"alerting\"} == 1) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Devices Offline",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "count(meraki_device_status{status=\"offline\"} == 1) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Clients (org, lookback window)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "meraki_org_clients", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "License Days Remaining",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "(meraki_license_expiration_timestamp_seconds - time()) / 86400", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 30 }, { "color": "green", "value": 90 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Last Poll Age (fast group)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "time() - meraki_exporter_last_poll_timestamp_seconds{group=\"fast\"}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 600 }, { "color": "red", "value": 900 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Uplink Packet Loss",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "meraki_uplink_loss_percent", "legendFormat": "{{serial}} {{uplink}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Uplink Latency",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "meraki_uplink_latency_seconds", "legendFormat": "{{serial}} {{uplink}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Clients per Network",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "meraki_network_clients", "legendFormat": "{{network_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Wireless Channel Utilization (total)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "meraki_wireless_channel_utilization_percent{kind=\"total\"}", "legendFormat": "{{serial}} {{band}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Devices Not Online",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "meraki_device_status{status=~\"offline|alerting|dormant\"} == 1", "instant": true, "format": "table" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true },
            "indexByName": {},
            "renameByName": { "name": "Device", "serial": "Serial", "network_name": "Network", "status": "Status" }
          }
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Collector Duration",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "meraki_exporter_collector_duration_seconds", "legendFormat": "{{collector}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Open Critical Alerts",
      "description": "Requires the opt-in alerts collector (COLLECTORS_ENABLED=...,alerts).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "sum(meraki_org_open_alerts{severity=\"critical\"}) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Sensors Reporting Water",
      "description": "Requires the opt-in sensors collector (COLLECTORS_ENABLED=...,sensors).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "count(meraki_sensor_water_detected == 1) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Sensor Doors Open",
      "description": "Requires the opt-in sensors collector (COLLECTORS_ENABLED=...,sensors).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "count(meraki_sensor_door_open == 1) or vector(0)", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] }
        },
        "overrides": []
      }
    }
  ]
}
